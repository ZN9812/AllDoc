# 서버 설정 예시입니다. 이 파일을 .env 로 복사해서 값을 채우세요.
# .env 는 저장소에 올리지 않습니다(.gitignore). 비밀 값은 절대 브라우저 코드에 넣지 마세요.

# 서버가 듣는 포트와, 사용자가 접속하는 주소(구글 로그인 되돌아오기 주소에 쓰입니다)
PORT=8787
PUBLIC_URL=http://localhost:8787

# 로그인 세션 서명용 비밀 문자열. 32자 이상 무작위 값 (예: openssl rand -hex 32)
SESSION_SECRET=

# 로그인 방식
#   google : 구글 로그인(운영용)
#   dev    : 개발용 가짜 로그인(NODE_ENV=production 에서는 동작하지 않음)
#   none   : 로그인 없이 AI 사용(한도 없음. 사내망 등 신뢰할 수 있는 환경에서만)
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 사용자 1명이 하루에 쓸 수 있는 AI 요청 횟수와, 하루가 바뀌는 기준 시간대
DAILY_AI_LIMIT=5
APP_TIMEZONE=Asia/Seoul

# AI 연결
#   anthropic : Claude (ANTHROPIC_API_KEY 필요)
#   mock      : 실제 AI 없이 정해진 예시 제안만 돌려주는 데모/개발용
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 선택: 작업별 모델·시스템 프롬프트·옵션을 바꾸는 설정 파일 경로 (docs/AI.md 참고)
AI_CONFIG_PATH=

# 서버가 만드는 데이터(SQLite 파일)를 둘 폴더
DATA_DIR=./data
