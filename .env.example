# 서버 설정 예시입니다. 이 파일을 .env 로 복사해서 값을 채우세요.
# .env 는 저장소에 올리지 않습니다(.gitignore). 비밀 값은 절대 브라우저 코드에 넣지 마세요.
#
# 처음 시험해 볼 때는 아래 두 줄만 바꾸세요:  AUTH_MODE=dev  ·  AI_PROVIDER=mock
# 서버는 이 파일을 개발·시험용으로만 자동으로 읽습니다. 운영(NODE_ENV=production)에서는 읽지 않으니,
# Docker 의 env_file 이나 systemd 의 EnvironmentFile 처럼 실행 환경에서 값을 넣으세요(docs/DEPLOY.md).

# 서버가 듣는 포트와, 사용자가 접속하는 주소(구글 로그인 되돌아오기 주소에 쓰입니다)
PORT=8787
PUBLIC_URL=http://localhost:8787

# 로그인 세션 서명용 비밀 문자열. 32자 이상 무작위 값 (예: openssl rand -hex 32)
SESSION_SECRET=

# 로그인 방식
#   google : 구글 로그인(운영용)
#   dev    : 개발용 가짜 로그인(NODE_ENV=production 에서는 동작하지 않음)
#   none   : 로그인 없이 AI 사용(한도 없음. 사내망 등 신뢰할 수 있는 환경에서만)
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 사용자 1명이 하루에 쓸 수 있는 AI 요청 횟수와, 하루가 바뀌는 기준 시간대
DAILY_AI_LIMIT=5
APP_TIMEZONE=Asia/Seoul

# AI 연결
#   anthropic : Claude (ANTHROPIC_API_KEY 필요)
#   mock      : 실제 AI 없이 정해진 예시 제안만 돌려주는 데모/개발용
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 선택: 작업별 모델·시스템 프롬프트·옵션을 바꾸는 설정 파일 경로 (docs/AI.md 참고)
AI_CONFIG_PATH=

# 선택: 요금제 파일(JSON). 없으면 DAILY_AI_LIMIT 로 만든 무료 요금제 하나만 둡니다(docs/DEPLOY.md "요금제와 관리자 도구")
PLANS_CONFIG_PATH=
# 선택: 전체 사용자의 하루 AI 원가 상한(달러). 넘으면 그날은 AI 를 멈춥니다
AI_DAILY_BUDGET_USD=

# 선택: 약관 판과 주소. 판을 넣으면 로그인한 사용자가 동의해야 AI 를 쓸 수 있습니다(두 주소도 필요)
TERMS_VERSION=
TERMS_URL=
PRIVACY_URL=

# 선택: 비공개 베타. invite 로 켜면 초대받은 사람만 로그인·가입합니다(초대는 admin.js invite 로 관리, docs/DEPLOY.md "비공개 베타")
BETA_MODE=off

# 선택: 하단에 보여 줄 사업자 정보. 넣은 항목만 보이고, 모두 비우면 하단에 사업자 정보가 나오지 않습니다
BUSINESS_NAME=
BUSINESS_OWNER=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_PRIVACY_OFFICER=
BUSINESS_HOSTING=
# 선택: 문의 창구(하단과 베타 로그인 창에 보입니다). 이메일이나 http(s) 주소
CONTACT_EMAIL=
CONTACT_URL=
# 선택: 정책 문서 폴더. terms.md·privacy.md·refund.md 가 있으면 /terms·/privacy·/refund 에 보이고, 없으면 "준비 중"
POLICY_DIR=

# 선택: LaTeX 컴파일(docs/DEPLOY.md "LaTeX 컴파일")
#   off  : 컴파일 없음(기본). LaTeX 프로젝트는 열고 고치고 내려받을 수만 있습니다
#   mock : 실제 TeX 없이 정해진 예시 PDF·로그를 돌려주는 데모/개발용
#   http : 컴파일 일꾼(compiler/, docker compose --profile latex)
COMPILER=off
# http 일 때: 일꾼 주소(쉼표로 여러 개)와 요청 서명 비밀값(32자 이상, 일꾼과 같은 값. openssl rand -hex 32)
COMPILER_URLS=
COMPILER_SECRET=
# 서버 전체 동시 컴파일 수와 기다릴 수 있는 수
COMPILER_CONCURRENCY=2
COMPILER_QUEUE=10
# 컴파일하려고 받은 파일을 마지막으로 쓴 날부터 며칠 두는지(임시 기본값, 결정 필요)
TEX_RETENTION_DAYS=7

# 서버가 만드는 데이터(SQLite 파일)를 둘 폴더
DATA_DIR=./data
# 하루 한 번 데이터 스냅숏: 둘 폴더(기본 DATA_DIR/backups)와 남길 개수(0 이면 끔). 서버 밖 복사는 직접 하세요
BACKUP_DIR=
BACKUP_KEEP=14
